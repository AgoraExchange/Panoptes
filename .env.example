# PANOPTES - Environment Variables
# Copy this file to .env.local and fill in values as needed.
# The platform works without most keys. Data sources with missing keys are gracefully skipped.

# Data Source API Keys (optional)
# FIRMS_API_KEY=                        # NASA FIRMS fire data
# AIS_API_KEY=                          # Maritime vessel tracking
# OPENSKY_USERNAME=                     # OpenSky username - enhances flight data
# OPENSKY_PASSWORD=                     # OpenSky password - enhances flight data
# OPENSKY_CLIENT_ID=                    # OpenSky OAuth2 - higher rate limits
# OPENSKY_CLIENT_SECRET=                # OpenSky OAuth2
# N2YO_API_KEY=                         # Satellite tracking

# Scanner Backend (required for RECON features)
# SCANNER_URL=http://your-scanner:7700  # Panoptes scanner backend URL
# SCANNER_KEY=                          # Scanner authentication key
